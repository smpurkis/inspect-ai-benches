fn add(a, b) {
    return a + b
}

fn factorial(n) {
    if n <= 1 { return 1 }
    let result = 1
    let i = 2
    loop {
        if i > n { break }
        result *= i
        i += 1
    }
    return result
}

fn fibonacci(n) {
    let a = 0
    let b = 1
    let i = 0
    loop {
        if i >= n { break }
        let temp = a + b
        a = b
        b = temp
        i += 1
    }
    return a
}

fn main() {
    print("add(3, 4) = ${add(3, 4)}")
    print("5! = ${factorial(5)}")
    print("10! = ${factorial(10)}")
    print("fib(0) = ${fibonacci(0)}")
    print("fib(1) = ${fibonacci(1)}")
    print("fib(8) = ${fibonacci(8)}")
}
