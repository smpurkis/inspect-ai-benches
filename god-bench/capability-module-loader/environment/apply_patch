#!/usr/bin/env python3

import subprocess
import sys


def main() -> int:
    patch_text = sys.stdin.read()
    if not patch_text.strip():
        print("apply_patch: no patch provided on stdin", file=sys.stderr)
        return 2
    process = subprocess.run(
        ["git", "apply", "--whitespace=nowarn", "-"],
        input=patch_text,
        text=True,
        capture_output=True,
    )
    if process.returncode != 0:
        sys.stderr.write(process.stderr or "apply_patch: git apply failed\n")
    return process.returncode


if __name__ == "__main__":
    raise SystemExit(main())
