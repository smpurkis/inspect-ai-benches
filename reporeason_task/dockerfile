FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl unzip nodejs \
 && rm -rf /var/lib/apt/lists/*

# Install Bun
RUN curl -fsSL https://bun.sh/install | bash  # installs to /root/.bun by default [web:62]

ENV BUN_INSTALL=/root/.bun
ENV PATH="${BUN_INSTALL}/bin:${PATH}"

RUN bun install -g opencode-ai

WORKDIR /app

ARG DEFAULT_PORT=5000
ENV OPCODE_PORT=${DEFAULT_PORT}
ENV PORT=${DEFAULT_PORT}

CMD ["sh", "-c", "opencode serve --port ${PORT:-$OPCODE_PORT}"]
